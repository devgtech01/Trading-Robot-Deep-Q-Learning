# Servico systemd do painel do Robo de Trading DQN.
#
# Por que systemd e nao PM2: o PM2 perde o vinculo pai-filho com este processo
# Python -- ele nasce e e reparentado ao init (PPID 1). O PM2 entao considera
# que morreu, sobe outro, que bate em "Address already in use", e o ciclo se
# repete indefinidamente enquanto o processo real segue servindo orfao. Isso
# acontecia desde antes de qualquer mudanca (542 restarts na config original).
# O systemd com Type=simple acompanha o processo corretamente.
#
# Instalacao:
#   sudo cp deploy/dqn-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dqn-dashboard

[Unit]
Description=Painel do Robo de Trading DQN (B3 + Cripto)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/trading-robot

# O virtualenv fica em "venv" (sem ponto). O python do sistema NAO tem
# numpy/torch/flask -- apontar para ele mata o painel no boot.
ExecStart=/var/www/trading-robot/venv/bin/python dashboard.py \
    --host 0.0.0.0 \
    --port 8000 \
    --no-browser

# Carregar PyTorch e fechar o socket levam tempo; o padrao de 90s do systemd ja
# cobre, mas deixamos explicito para nao sobrar socket preso entre reinicios.
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGINT

# A B3 opera no horario de Brasilia e o agendador usa datetime.now().
Environment=TZ=America/Sao_Paulo
Environment=PYTHONUNBUFFERED=1
# Torch abrindo uma thread por nucleo so gera disputa de CPU nesta VPS.
Environment=OMP_NUM_THREADS=2

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
